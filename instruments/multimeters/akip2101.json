{
    "model_name": "AKIP-2101 / Siglent SDM3055",
    "keywords": ["AKIP-2101", "SIGLENT"],
    "timeout": 5000,
    "encoding": "utf-8",
    "init_commands": [
        "*RST",
        "SENS:FUNC \"VOLT:DC\"",
        "SENS:VOLT:DC:NPLC 1",
        "SENS:VOLT:DC:RANG:AUTO OFF"
    ],
    "measure_command": "READ?",
    "ranges": [0.2, 2.0, 20.0, 200.0, 1000.0]
}